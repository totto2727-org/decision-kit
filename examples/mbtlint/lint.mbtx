---
import {
  "moonbitlang/async@0.22.9",
  "moonbitlang/core/debug",
  "moonbitlang/core/env",
  "moonbitlang/x@0.5.7/fs",
  "totto2727/decision-kit@0.1.0" @decision,
  "totto2727/mbtlint@0.1.0/core" @mbtlint,
}
---

enum Format { Decisions; WorkersAI; SystemOne }

async fn check(path : String, cache_dir : String, format : Format) -> Bool {
  let source = @fs.read_file_to_string(path)
  let tests : Array[String] = []
  let collect = @mbtlint.Rule("collect", ctx => @mbtlint.Listener(on_decl=decl => {
    if decl is TopTest(name=Some(_), loc~, ..) && ctx.text(loc) is Some(text) {
      tests.push(text)
    }
  }))
  let parse_errors = @mbtlint.Config().with_rule(collect).lint(path~, source~)
  if !parse_errors.is_empty() {
    for d in parse_errors { println(d) }
    return false
  }
  let review : Set[String] = Set([])
  for text in tests {
    let request = match format {
      WorkersAI => @decision.PredicateRequest::jev(
        endpoint="https://api.cloudflare.com/client/v4/accounts/example/ai/run",
        gateway_id="team", scope="local-demo", name="accurate",
        instructions="Does the test title describe its assertion?", input=text,
      )
      SystemOne => @decision.PredicateRequest::jev(
        endpoint="https://api.typesafe.ai/v1/systemone",
        model="jev-latest", scope="local-demo", name="accurate",
        instructions="Does the test title describe its assertion?", input=text,
      )
      Decisions => @decision.PredicateRequest::new(
        endpoint="https://gateway.ai.cloudflare.com/v1/example/team/openai/decisions",
        scope="local-demo", model="gpt-6-luna", name="accurate",
        instructions="Does the test title describe its assertion?", input=text,
      )
    }
    // Cache-only. A missing result is an error, not a passing test.
    if @decision.read_cached(request, cache_dir~, ttl=3600) < 0.1 {
      review.add(text)
    }
  }
  let rule = @mbtlint.Rule("review/test-title", ctx => @mbtlint.Listener(on_decl=decl => {
    if decl is TopTest(name=Some((_, name_loc)), loc~, ..) &&
      ctx.text(loc) is Some(text) && review.contains(text) {
      (ctx.report)(name_loc, "Review whether the test title describes the assertion.")
    }
  }))
  let diagnostics = @mbtlint.Config().with_rule(rule).lint(path~, source~)
  for d in diagnostics { println(d) }
  diagnostics.is_empty()
}

async fn run(path : String, cache_dir : String, format : Format) -> Unit {
  try check(path, cache_dir, format) catch {
    err => { @debug.debug(err); @env.exit(2) }
  } noraise {
    false => @env.exit(1)
    true => ()
  }
}

async fn main {
  match @env.args()[1:] {
    [path, cache_dir] => run(path, cache_dir, Decisions)
    [path, cache_dir, "--jev"] => run(path, cache_dir, WorkersAI)
    [path, cache_dir, "--systemone"] => run(path, cache_dir, SystemOne)
    _ => {
      println("Expected a source path, private cache directory, and optional --jev or --systemone.")
      @env.exit(2)
    }
  }
}
