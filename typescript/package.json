{
  "name": "@totto2727/decision-kit",
  "version": "0.1.0",
  "description": "Node client for cached predicate decisions through Cloudflare AI Gateway",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test index.test.ts",
    "test:oxlint": "node --test examples/oxlint/plugin.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
